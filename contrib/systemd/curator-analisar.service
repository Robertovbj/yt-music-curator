# Lote diário de download + análise: roda até esgotar a cota do dia ([fila] cota_diaria). Instalação (usuário, sem root):
#   cp contrib/systemd/curator-analisar.* ~/.config/systemd/user/
#   (ajuste WorkingDirectory para a pasta do clone e o PATH para onde estiver o uv)
#   systemctl --user daemon-reload && systemctl --user enable --now curator-analisar.timer
# Logs: journalctl --user -u curator-analisar
[Unit]
Description=yt-music-curator: lote diário de análise de áudio
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/yt-music-curator
# uv (instalador oficial em ~/.local/bin; com mise, use %h/.local/share/mise/shims) + ffmpeg, ffprobe, deno
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env uv run --extra analise curator -v analisar --aguardar
# SIGTERM: o worker termina a faixa atual e para; nada fica "baixando" na fila
KillSignal=SIGTERM
TimeoutStopSec=180
Nice=10
IOSchedulingClass=idle
